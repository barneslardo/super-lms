# Database (Postgres on host port 5440 — SIS uses 5437)
DATABASE_URL=postgresql://lms:lms@localhost:5440/lms_demo

# Public URLs (production CNAMEs)
#   superlms.skylarbarnes.com → Vite UI (:5174)  [or static build]
#   lmsapi.skylarbarnes.com   → LMS API (:3041)  — NOT Postgres :5440
APP_URL=https://superlms.skylarbarnes.com
API_PUBLIC_URL=https://lmsapi.skylarbarnes.com
CORS_ORIGIN=https://superlms.skylarbarnes.com
SESSION_COOKIE_DOMAIN=.skylarbarnes.com
TRUST_PROXY=true

SESSION_SECRET=change-me-to-a-long-random-string

API_PORT=3041
NODE_ENV=production

# Okta org (same as SIS demo)
OKTA_ORG_URL=https://sledai.oktapreview.com

# Custom AS used for SIS API / ID-JAG hop 2 (same as SIS)
OKTA_ISSUER=https://sledai.oktapreview.com/oauth2/auszblykhlQkrnOmA1d7
RESOURCE_AS_ISSUER=https://sledai.oktapreview.com/oauth2/auszblykhlQkrnOmA1d7

# LMS OIDC web app — private_key_jwt (public JWK registered in Okta)
OKTA_OIDC_CLIENT_ID=
# OKTA_OIDC_CLIENT_SECRET=   # not used when private_key_jwt
OKTA_OIDC_AUTH_METHOD=private_key_jwt
OKTA_OIDC_PRIVATE_KEY_PATH=secrets/app-sign-on-key.json
OKTA_OIDC_REDIRECT_URI=https://lmsapi.skylarbarnes.com/auth/oidc/callback
OIDC_SCOPES=openid profile email groups offline_access

# ID-JAG agent client (must differ from OKTA_OIDC_CLIENT_ID; can reuse SIS agent registration)
OKTA_AGENT_REGISTRATION_ID=wlpzfntwqat4SXBba1d7
AGENT_CLIENT_ID=wlpzfntwqat4SXBba1d7
AGENT_PRIVATE_KEY_PATH=secrets/agent-private-key.json
AGENT_TOKEN_SCOPE=sis.students.read.self sis.students.academic sis.students.read

# SIS Cross App Access target
SIS_API_URL=https://sis-api.skylarbarnes.com
SIS_APP_URL=https://sis.skylarbarnes.com

# Optional: Okta Management API for group lookup / JWK registration script
# OKTA_API_TOKEN=

# xAI (Study Helper chatbot)
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Demo admins: comma-separated emails always granted the admin role, checked
# BEFORE Okta group membership. Leave EMPTY so Okta groups are the only path to
# admin; populate only for a local demo where you control the accounts.
DEMO_ADMIN_EMAILS=
